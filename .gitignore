# ============================================
# Environment & Secrets (CRITICAL)
# ============================================
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# A blanket ignore on *.properties also hid the application config, which
# holds no secrets and is needed to run the app at all. The re-includes below
# name the files that are safe; anything else ending in .properties stays out.
*.properties
!*.example.properties
!*.properties.example
!application.properties
!application-prod.properties
!pom.xml
secrets/
private/
credentials/
.vault/

