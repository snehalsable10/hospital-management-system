# ====================================
# Development Profile - EXAMPLE
# ====================================
# Copy this to application-dev.properties and adjust it for your machine:
#
#   cp application-dev.properties.example application-dev.properties
#
# The real file is gitignored, because a local copy usually ends up holding a
# real database password. Keep it that way.
#
# Every value below works as-is against the docker compose stack, and the two
# credentials read from the environment first, so you can override them
# without editing the file.

# ====================================
# Development Profile - Local Machine
# ====================================

# ====================================
# Server Configuration
# ====================================
server.port=8080

# ====================================
# Database Configuration (PostgreSQL) - LOCAL DEV
# ====================================
spring.datasource.url=jdbc:postgresql://localhost:5432/hospital_management_db
spring.datasource.username=postgres
spring.datasource.password=${DB_PASSWORD:postgres}
spring.datasource.driver-class-name=org.postgresql.Driver

# ====================================
# JPA & Hibernate Configuration - DEV
# ====================================
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# ====================================
# JWT Configuration - DEV
# ====================================
# IMPORTANT: This is a development key only
# For production, use a strong random 256-bit key from environment variable
jwt.secret=${JWT_SECRET:dev_secret_key_do_not_use_in_production_this_is_only_for_local_testing_12345678}
jwt.expiration=1800000

# ====================================
# Logging Configuration - DEV
# ====================================
# Development logging: more verbose than prod, but still safe
# IMPORTANT: Never log sensitive data (passwords, tokens, PHI)
logging.level.root=WARN
logging.level.com.hms=INFO
logging.level.org.springframework.web=INFO
logging.level.org.springframework.security=INFO
logging.level.org.springframework.boot.autoconfigure=INFO

# Reduce noise from third-party libraries
logging.level.org.hibernate=WARN
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# JSON logging for structured analysis
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %logger{36} - %msg%n
logging.file.name=logs/application-dev.log
logging.file.max-size=10MB
logging.file.max-history=10

# ====================================
# CORS Configuration - DEV
# ====================================
# Allow React dev server on 3000/3002
server.servlet.context-path=/

# ====================================
# Application Info - DEV
# ====================================
spring.application.name=Hospital Management System (DEV)
app.version=1.0.0-DEV
app.environment=development

# ====================================
# Redis Cache Configuration - DEV
# ====================================
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.database=0
spring.data.redis.timeout=60000
spring.data.redis.lettuce.pool.max-active=20
spring.data.redis.lettuce.pool.max-idle=10
spring.data.redis.lettuce.pool.min-idle=5

# ====================================
# Spring Boot Actuator - Health & Metrics - DEV
# ====================================
# Expose all actuator endpoints in development
management.endpoints.web.exposure.include=health,metrics,info
management.endpoints.web.base-path=/actuator
# Show detailed health information in development
management.endpoint.health.show-details=always
management.endpoint.health.show-components=when-authorized
# Enable metrics endpoints
management.metrics.enable.all=true
management.metrics.export.simple.enabled=true
# Redis is a cache, not a hard dependency - see the note in application-prod.properties.
management.health.redis.enabled=false

# ====================================
# Performance Monitoring - DEV
# ====================================
# Log a WARN for any request slower than this (milliseconds)
hms.performance.slow-request-threshold-ms=500
# Hibernate logs any query slower than this (milliseconds)
spring.jpa.properties.hibernate.session.events.log.LOG_QUERIES_SLOWER_THAN_MS=300
# Slow queries log at INFO on this logger; org.hibernate is WARN above, so set it explicitly
logging.level.org.hibernate.SQL_SLOW=INFO
# ====================================
# Authentication Hardening
# ====================================
# An account is refused after this many consecutive failed sign-ins, for this
# long. The window slides: each failure pushes the expiry out, so guesses
# cannot be paced to stay under the limit.
hms.security.login.max-attempts=5
hms.security.login.lockout-minutes=15

# Per-IP cap on /api/auth/login and /api/auth/signup - the only endpoints
# reachable without a token. Counted in a fixed window.
hms.security.rate-limit.enabled=true
hms.security.rate-limit.requests=20
hms.security.rate-limit.window-seconds=60

# ====================================
# Database Migrations (Flyway)
# ====================================
# The schema is owned by src/main/resources/db/migration, not by Hibernate.
# ddl-auto is validate everywhere: an entity that has drifted from the schema
# fails startup instead of silently altering tables under a running system.
#
# baseline-on-migrate handles a database that already has these tables: it is
# recorded as already being at the baseline version and V1 is not re-run.
# baseline-version must therefore be 1, matching V1 - at 0 Flyway would mark
# the database as pre-V1 and then try to create tables that are already there.
# An empty database is unaffected and simply runs V1.
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1
spring.flyway.baseline-description=baseline schema

# Origins the deployed frontend is served from, comma-separated. Development
# localhost ports are always allowed; this adds to them. Set it to the real
# frontend domain in production - the browser blocks the UI without it.
hms.security.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:}

# ====================================
# First-Administrator Bootstrap
# ====================================
# A database with no administrator cannot get one: public signup always makes
# a PATIENT, and promoting an account needs an administrator already. If both
# values below are set and no active administrator exists, one is created at
# startup. It never runs again once an administrator is present.
#
# Supply these through the environment for a first deployment, then change the
# password and clear HMS_ADMIN_PASSWORD.
hms.bootstrap.admin.email=${HMS_ADMIN_EMAIL:}
hms.bootstrap.admin.password=${HMS_ADMIN_PASSWORD:}
hms.bootstrap.admin.username=${HMS_ADMIN_USERNAME:admin}

# Access tokens are short-lived because they travel on every request; the
# client swaps an expired one for a fresh pair at /api/auth/refresh. The
# refresh token is long-lived but single-use - each exchange revokes the one
# presented - so a stolen one stops working the moment the legitimate holder
# refreshes.
jwt.refresh-expiration=${JWT_REFRESH_EXPIRATION:604800000}
